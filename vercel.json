{
  "framework": null,
  "outputDirectory": "frontend/out",
  "cleanUrls": true,
  "redirects": [
    { "source": "/index.html", "destination": "/login", "permanent": false },
    { "source": "/register.html", "destination": "/register", "permanent": false }
  ],
  "rewrites": [
    { "source": "/guilds/:id", "destination": "/guilds/_.html" }
  ]
}
