# Copie este arquivo para .env antes de executar localmente. Nunca versione o .env.
POSTGRES_DB=questify
POSTGRES_USER=questify
POSTGRES_PASSWORD=troque_esta_senha_de_desenvolvimento
POSTGRES_PORT=55432

# Conexão usada pela aplicação, migrations, seeds e testes.
# Na Vercel, defina esta variável nas Environment Variables do projeto (banco PostgreSQL gerenciado).
DATABASE_URL=postgresql://questify:troque_esta_senha_de_desenvolvimento@127.0.0.1:55432/questify
# TLS opcional: "require" ou "verify-full" (ou use ?sslmode=require na URL). Vazio no Postgres local.
DATABASE_SSL=

# Ambiente: seeds só rodam com development ou staging. APP_ENV tem precedência sobre NODE_ENV
# (na Vercel use APP_ENV=staging em Preview; nunca defina development/staging em Production).
NODE_ENV=development
# APP_ENV=development
